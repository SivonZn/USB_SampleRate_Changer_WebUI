+        ;;
+    --all)
+        show_all=true
+        ;;
+    -h | --help)
+        echo "Usage: ${0##*/} [--all]"
+        echo "Reports ALSA PCM endpoints together with their role and runtime state."
+        exit 0
+        ;;
+    *)
+        echo "Unsupported option: $1" 1>&2
+        exit 1
