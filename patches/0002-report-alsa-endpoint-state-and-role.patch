+if "$show_all"; then
+    if [ -r /proc/asound/cards ]; then
+        echo
+        echo "ALSA cards:"
+        cat /proc/asound/cards
+    fi
+    if [ -r /proc/asound/pcm ]; then
+        echo
+        echo "ALSA PCM device map:"
+        cat /proc/asound/pcm
+    fi
+fi
+
+print_pcm_endpoint()
+{
+    params_file="$1"
+    pcm_dir="${params_file%/sub0/hw_params}"
+    pcm_node="${pcm_dir##*/}"
+    info_file="$pcm_dir/sub0/info"
+    status_file="$pcm_dir/sub0/status"
+    params="`cat "$params_file" 2>/dev/null`"
+
+    if [ "$params" = "closed" ]; then
+        if ! "$show_all"; then
+            return
+        fi
+        pcm_state="CLOSED"
+    else
+        pcm_state="UNKNOWN"
+        if [ -r "$status_file" ]; then
+            detected_state="`sed -n 's/^state:[[:space:]]*//p' "$status_file"`"
+            if [ -n "$detected_state" ]; then
+                pcm_state="$detected_state"
+            fi
+        fi
+    fi
+
+    pcm_id=""
+    pcm_stream=""
+    if [ -r "$info_file" ]; then
+        pcm_id="`sed -n 's/^id:[[:space:]]*//p' "$info_file"`"
+        pcm_stream="`sed -n 's/^stream:[[:space:]]*//p' "$info_file"`"
+    fi
+    if [ -z "$pcm_stream" ]; then
+        case "$pcm_node" in
+            *p) pcm_stream="PLAYBACK" ;;
+            *c) pcm_stream="CAPTURE" ;;
+            *)  pcm_stream="UNKNOWN" ;;
+        esac
+    fi
+
+    echo
+    echo "Endpoint: $pcm_dir"
+    echo "  Direction: $pcm_stream"
+    if [ -n "$pcm_id" ]; then
+        echo "  PCM ID: $pcm_id"
+    fi
+    echo "  State: $pcm_state"
+
+    if [ "$params" != "closed" ]; then
+        owner_pid=""
+        if [ -r "$status_file" ]; then
+            owner_pid="`sed -n 's/^owner_pid[[:space:]]*:[[:space:]]*//p' "$status_file"`"
+        fi
+        if [ -n "$owner_pid" ]; then
+            owner_name=""
+            if [ -r "/proc/$owner_pid/cmdline" ]; then
+                owner_name="`tr '\000' ' ' < "/proc/$owner_pid/cmdline" 2>/dev/null`"
+            fi
+            if [ -n "$owner_name" ]; then
+                echo "  Owner: $owner_pid ($owner_name)"
+            else
+                echo "  Owner PID: $owner_pid"
+            fi
+        fi
+        echo "  Hardware parameters:"
+        echo "$params" | sed 's/^/    /'
+    fi
+
+}
+
+for params_file in /proc/asound/card*/pcm*/sub0/hw_params; do
+    if [ -r "$params_file" ]; then
+        print_pcm_endpoint "$params_file"
+    fi
+done
+
 
-if [ -r "/proc/asound/card1/id" ]; then
-    if [ ! "`cat /proc/asound/card1/id`" = "closed"  -a  -r "/proc/asound/card1/stream0" ];then
-        echo "\nDAC Hardware Profile:"
-        cat '/proc/asound/card1/stream0'
+profile_count=0
+for profile_file in /proc/asound/card*/stream*; do
+    if [ -r "$profile_file" ]; then
+        profile_count=$((profile_count + 1))
+        card_dir="${profile_file%/*}"
+        card_id=""
+        if [ -r "$card_dir/id" ]; then
+            card_id="`cat "$card_dir/id" 2>/dev/null`"
+        fi
+        echo
+        if [ -n "$card_id" ]; then
+            echo "Hardware profile: $profile_file ($card_id)"
+        else
+            echo "Hardware profile: $profile_file"
+        fi
+        cat "$profile_file"
     fi
-fi
-
+done
+
+if "$show_all" && [ "$profile_count" -eq 0 ]; then
+    echo
+    echo "No ALSA hardware stream profile is currently exposed."
+fi
