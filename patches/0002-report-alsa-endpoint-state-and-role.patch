+esac
 
-if [ "$rst" = "closed" ]; then
-    # For USB hardware offload use
-    for i in `seq 0 90`; do
-    
-        file="/proc/asound/card0/pcm${i}p/sub0/hw_params"
-        if [ -r "$file" ]; then
-            rst="`cat $file`"
